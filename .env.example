# Copy to .env (never committed) and fill in.
# Gmail app password for the inbox named by self_email in data/household.json.
GMAIL_APP_PASSWORD=
# dev = no login (localhost or a private network only); google = Google sign-in + allowlist.
AUTH_MODE=dev
# Comma-separated emails allowed in when AUTH_MODE=google.
FM_ALLOWLIST=
# Which model answers (mail briefings, Ask, screenshots). Leave it blank to use a signed-in
# `claude` or `codex` command-line tool (your Claude or ChatGPT plan). Or name a provider:
#   claude-cli | codex-cli | anthropic | openai | gemini
FM_LLM_PROVIDER=
# Optional: a model other than the provider's default (see DEFAULT_MODELS in llm.py).
FM_LLM_MODEL=
# API keys. Each is read only when FM_LLM_PROVIDER names its provider.
FM_ANTHROPIC_API_KEY=
FM_OPENAI_API_KEY=
FM_GEMINI_API_KEY=
# Any OpenAI-compatible server, e.g. Ollama at http://localhost:11434/v1 (set FM_LLM_MODEL too).
FM_LLM_BASE_URL=
# To estimate API spend in the cost ledger: USD per million input / output tokens.
FM_LLM_PRICE_IN=
FM_LLM_PRICE_OUT=
# Contact address sent to the free geocoding service, as its usage policy asks.
FM_CONTACT_EMAIL=
