# Copy to .env (never committed) and fill in.
# Gmail app password for the inbox named by self_email in data/household.json.
GMAIL_APP_PASSWORD=
# dev = no login (localhost or a private network only); google = Google sign-in + allowlist.
AUTH_MODE=dev
# Comma-separated emails allowed in when AUTH_MODE=google.
FM_ALLOWLIST=
# Contact address sent to the free geocoding service, as its usage policy asks.
FM_CONTACT_EMAIL=
